# Скопируйте в .env и задайте значения: cp .env.example .env && chmod 600 .env
# Описание переменных — docs/architecture.md, «Конфигурация».

# Адрес API instudy, только https://
INSTUDY_API_URL=
# Сервисный токен: админ instudy выдаёт его командой `python -m app.cli service-add home-gpu`
SERVICE_TOKEN=
# Только для разовой загрузки моделей (gated pyannote/speaker-diarization-community-1); в работе не нужен
HF_TOKEN=

POLL_INTERVAL_SEC=60
HEARTBEAT_SEC=300
MAX_AUDIO_BYTES=314572800
MAX_AUDIO_SEC=21600
MAX_SEGMENT_SEC=22
KEEP_MODELS_LOADED=false
RESULTS_KEEP_DAYS=14
MIN_FREE_GB=10
LOG_LEVEL=INFO
